{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberrota",
  "main": "worker/src/index.mjs",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyberrota-db",
      "database_id": "7053985b-1e88-4fed-a2c1-f26ae0ee3aef",
      "migrations_dir": "server/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "CyberrotaWorkerRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CyberrotaWorkerRoom"] }],
  "vars": {
    "GOOGLE_CLIENT_ID": "454744682449-dn7172o0kd5ti6hbv9l2p1pa4f40v0bg.apps.googleusercontent.com"
  }
}
